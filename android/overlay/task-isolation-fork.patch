From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OMP Termux Port <omp-termux@local>
Date: Fri, 28 Aug 2026 00:00:00 +0000
Subject: [PATCH] feat(task): support explicit repoRoot for isolated subagent worktrees

Allow manual specification and strict validation of repository root for isolated task workers.
---
 packages/coding-agent/src/task/isolation-runner.ts |  4 ++--
 .../coding-agent/src/task/structured-subagent.ts   |  3 ++-
 packages/coding-agent/src/task/worktree.ts         | 26 +++++++++++++++++-----
 3 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/packages/coding-agent/src/task/isolation-runner.ts b/packages/coding-agent/src/task/isolation-runner.ts
index 71d12b08ba..64a791f013 100644
--- a/packages/coding-agent/src/task/isolation-runner.ts
+++ b/packages/coding-agent/src/task/isolation-runner.ts
@@ -101,8 +101,8 @@ export interface IsolationContext {
  * each isolated spawn against. Throws when the cwd is not inside a git
  * repository; callers surface the error as a task-tool failure.
  */
-export async function prepareIsolationContext(cwd: string): Promise<IsolationContext> {
-	const repoRoot = await getRepoRoot(cwd);
+export async function prepareIsolationContext(cwd: string, explicitRepoRoot?: string): Promise<IsolationContext> {
+	const repoRoot = await getRepoRoot(cwd, explicitRepoRoot);
 	const baseline = await captureBaseline(repoRoot);
 	return { repoRoot, baseline };
 }
diff --git a/packages/coding-agent/src/task/structured-subagent.ts b/packages/coding-agent/src/task/structured-subagent.ts
index e5189d0a00..ca473de879 100644
--- a/packages/coding-agent/src/task/structured-subagent.ts
+++ b/packages/coding-agent/src/task/structured-subagent.ts
@@ -578,7 +578,8 @@ export async function runStructuredSubagent(request: StructuredSubagentRequest):
 		let isolationContext: IsolationContext | null = null;
 		if (policy.isIsolated) {
 			try {
-				isolationContext = await prepareIsolationContext(request.session.cwd);
+				const explicitRepoRoot = (request.session.settings.get("task.isolation.repoRoot" as never) as string | undefined) || undefined;
+				isolationContext = await prepareIsolationContext(request.session.cwd, explicitRepoRoot);
 			} catch (error) {
 				const message = error instanceof Error ? error.message : String(error);
 				throw new StructuredSubagentError(
diff --git a/packages/coding-agent/src/task/worktree.ts b/packages/coding-agent/src/task/worktree.ts
index 1961d14a09..95d8b79cca 100644
--- a/packages/coding-agent/src/task/worktree.ts
+++ b/packages/coding-agent/src/task/worktree.ts
@@ -51,20 +51,33 @@ export interface WorktreeBaseline {
 	nested: Array<{ relativePath: string; baseline: RepoBaseline }>;
 }
 
-export async function getRepoRoot(cwd: string): Promise<string> {
+export async function getRepoRoot(cwd: string, explicitRepoRoot?: string): Promise<string> {
+	const targetCwd = explicitRepoRoot ? path.resolve(cwd, explicitRepoRoot) : cwd;
 	// Pure-jj check runs first so a jj workspace nested under an unrelated
 	// outer Git checkout is rejected at its own root rather than silently
 	// mutating the surrounding Git tree behind jj's back.
-	if (vcs.isPureJj(cwd)) {
+	if (vcs.isPureJj(targetCwd)) {
 		throw new Error(
 			"Isolated task execution requires a Git checkout, but this workspace is pure Jujutsu (`.jj/` without a colocated `.git/`). Run `jj git init --colocate` to add a Git checkout, or set `task.isolation.mode: none` to disable task isolation.",
 		);
 	}
 
-	const repoRoot = vcs.git(cwd)?.info().repoRoot;
-	if (repoRoot) return repoRoot;
+	const repoRoot = vcs.git(targetCwd)?.info().repoRoot;
+	if (!repoRoot) {
+		throw new Error(`Git repository not found for isolated task execution in ${targetCwd}.`);
+	}
+
+	if (explicitRepoRoot) {
+		const canonicalTarget = path.resolve(targetCwd);
+		const canonicalRoot = path.resolve(repoRoot);
+		if (canonicalTarget !== canonicalRoot) {
+			throw new Error(
+				`Configured task.isolation.repoRoot (${targetCwd}) is a subdirectory inside a repository (${repoRoot}), not the repository root itself.`,
+			);
+		}
+	}
 
-	throw new Error("Git repository not found for isolated task execution.");
+	return repoRoot;
 }
 
 const GIT_NO_INDEX_NULL_PATH = process.platform === "win32" ? "NUL" : "/dev/null";
@@ -498,8 +511,9 @@ export async function ensureIsolation(
 	baseCwd: string,
 	id: string,
 	preferred?: IsoBackendKind,
+	explicitRepoRoot?: string,
 ): Promise<IsolationHandle> {
-	const repoRoot = await getRepoRoot(baseCwd);
+	const repoRoot = await getRepoRoot(baseCwd, explicitRepoRoot);
 	const sourceCommonDir = vcs.requireGit(repoRoot).info().commonDir;
 	const baseDir = getWorktreeDir(getTaskIsolationSegment(repoRoot, id));
 	const mergedDir = path.join(baseDir, TASK_ISOLATION_MOUNT_DIR);
