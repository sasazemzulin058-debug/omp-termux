diff --git a/packages/utils/src/android-system.ts b/packages/utils/src/android-system.ts
new file mode 100644
index 0000000000..120db2092f
--- /dev/null
+++ b/packages/utils/src/android-system.ts
@@ -0,0 +1,60 @@
+import { spawn } from "node:child_process";
+import fs from "node:fs";
+
+export function isAndroidEnvironment(): boolean {
+	return (
+		process.platform === "android" ||
+		Boolean(process.env.TERMUX_VERSION) ||
+		Boolean(process.env.ANDROID_ROOT) ||
+		Boolean(process.env.PREFIX?.includes("com.termux"))
+	);
+}
+
+export function acquireWakeLock(): void {
+	if (!isAndroidEnvironment()) return;
+	try {
+		spawn("termux-wake-lock", [], { stdio: "ignore", detached: true }).unref();
+	} catch {}
+}
+
+export function releaseWakeLock(): void {
+	if (!isAndroidEnvironment()) return;
+	try {
+		spawn("termux-wake-unlock", [], { stdio: "ignore", detached: true }).unref();
+	} catch {}
+}
+
+export function adjustOomScore(score = -500): boolean {
+	if (!isAndroidEnvironment()) return false;
+	try {
+		const clamped = Math.max(-1000, Math.min(1000, Math.round(score)));
+		fs.writeFileSync("/proc/self/oom_score_adj", String(clamped));
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+export interface AndroidNotificationOptions {
+	id?: string;
+	title: string;
+	body: string;
+	icon?: string;
+	priority?: "high" | "low" | "default";
+}
+
+export function sendAndroidNotification(options: AndroidNotificationOptions): boolean {
+	if (!isAndroidEnvironment()) return false;
+	try {
+		const args: string[] = [];
+		if (options.id) args.push("--id", options.id);
+		args.push("--title", options.title);
+		args.push("--content", options.body);
+		if (options.priority) args.push("--priority", options.priority);
+		if (options.icon) args.push("--icon", options.icon);
+		spawn("termux-notification", args, { stdio: "ignore", detached: true }).unref();
+		return true;
+	} catch {
+		return false;
+	}
+}
