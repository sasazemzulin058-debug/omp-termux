@@ -0,0 +1,51 @@
+import { createHash } from "node:crypto";
+
+const SECRET_PATTERNS = [
+	/Bearer\s+[A-Za-z0-9_\-\.]{15,}/gi,
+	/sk-[a-zA-Z0-9_\-]{20,}/gi,
+	/https?:\/\/[^\s\/:]+:[^\s\/@]+@/gi,
+	/password\s*=\s*[^\s\r\n]+/gi,
+	/secret\s*=\s*[^\s\r\n]+/gi,
+	/api[_-]?key\s*=\s*[^\s\r\n]+/gi,
+	/token\s*=\s*[^\s\r\n]+/gi,
+	/--password\s+[^\s\r\n]+/gi,
+	/--token\s+[^\s\r\n]+/gi,
+	/--secret\s+[^\s\r\n]+/gi,
+	/--api-key\s+[^\s\r\n]+/gi,
+	/Cookie:\s*[^\r\n]+/gi,
+	/Authorization:\s*[^\r\n]+/gi,
+];
+
+export function redactEvidence(text: string, customPatterns: string[] = []): string {
+	let result = text;
+	for (const pattern of SECRET_PATTERNS) {
+		result = result.replace(pattern, "[REDACTED]");
+	}
+	for (const pat of customPatterns) {
+		try {
+			const reg = new RegExp(pat, "gi");
+			result = result.replace(reg, "[REDACTED]");
+		} catch {
+			// ignore invalid regex
+		}
+	}
+	return result;
+}
+
+export function opaqueDigest(text: string): string {
+	return createHash("sha256").update(text).digest("hex").slice(0, 16);
+}
+
+export function extractFailureSignature(
+	toolName: string,
+	params: Record<string, unknown>,
+	error: string,
+	customPatterns: string[] = [],
+): string {
+	const sanitizedError = redactEvidence(error, customPatterns);
+	const firstLine = sanitizedError.split("\n").find(line => line.trim().length > 0) ?? "UnknownError";
+	const rawParam = typeof params.command === "string" ? params.command : typeof params.path === "string" ? params.path : "";
+	const sanitizedParam = redactEvidence(rawParam, customPatterns).slice(0, 80);
+	const digest = opaqueDigest(`${sanitizedParam}:${firstLine}`);
+	return `${toolName}:${sanitizedParam}:${digest}`;
+}
