+++ b/packages/coding-agent/src/autolearn/candidate-ledger.ts
@@ -0,0 +1,432 @@
+import type { MemoryRuntimeContext } from "../memory-backend/types";
+import type { CandidateRow, LearnDatabase, TombstoneRow } from "./learn-db";
+import { redactEvidence } from "./redact";
+
+export interface CreateCandidateInput {
+	kind: "rule" | "fact" | "procedure";
+	scope?: "local" | "project" | "global";
+	title: string;
+	content: string;
+	signature: string;
+	evidence: string;
+	project?: string;
+}
+
+export interface RecordPassInput {
+	expectedVersion: number;
+	verifier: string;
+	evidence?: string;
+}
+
+export interface RecordPassResult {
+	success: boolean;
+	candidate?: CandidateRow;
+	error?: string;
+}
+
+export class CandidateLedger {
+	private readonly lockMap = new Map<string, Promise<unknown>>();
+
+	constructor(private readonly db: LearnDatabase) {
+		this.sweepStaleInFlightStates();
+	}
+
+	sweepStaleInFlightStates(): void {
+		try {
+			// Process crash recovery:
+			// Never blindly reset 'promoting' or 'deleting' to 'pending' because remote/backend state may be inconsistent.
+			// If promoting candidate already had projected memory id recorded, mark promoted. Otherwise set to 'needs_review'.
+			// If deleting candidate was in-flight, mark 'needs_review' so it requires user review/intervention rather than silent retry.
+			this.db.db
+				.query(
+					`UPDATE candidates
+					 SET status = CASE
+						WHEN status = 'promoting' AND projected_memory_id IS NOT NULL THEN 'promoted'
+						WHEN status = 'promoting' THEN 'needs_review'
+						WHEN status = 'deleting' AND projected_memory_id IS NOT NULL THEN 'needs_review'
+						WHEN status = 'deleting' THEN 'needs_review'
+						ELSE status
+					 END,
+					 updated_at = ?
+					 WHERE status IN ('promoting', 'deleting')`,
+				)
+				.run(Date.now());
+		} catch {
+			// ignore on schema initialization race
+		}
+	}
+	private async serialize<T>(key: string, op: () => Promise<T>): Promise<T> {
+		const prev = this.lockMap.get(key) ?? Promise.resolve();
+		let resolveNext!: () => void;
+		const next = new Promise<void>(res => {
+			resolveNext = res;
+		});
+		this.lockMap.set(key, next);
+		try {
+			await prev;
+			return await op();
+		} finally {
+			resolveNext();
+			if (this.lockMap.get(key) === next) {
+				this.lockMap.delete(key);
+			}
+		}
+	}
+
+	isTombstoned(signature: string, scope = "project", project?: string): boolean {
+		const row = this.db.db
+			.query("SELECT signature FROM tombstones WHERE signature = ? AND scope = ? AND project = ?")
+			.get(signature, scope, project ?? "") as TombstoneRow | null;
+		return row !== null;
+	}
+
+	createCandidate(input: CreateCandidateInput): string | null {
+		const scope = input.scope ?? "project";
+		if ((scope === "project" || scope === "local") && !input.project) {
+			throw new Error(`Cannot create ${scope}-scoped candidate without canonical project identity`);
+		}
+		const project = scope === "global" ? undefined : input.project;
+		if (this.isTombstoned(input.signature, scope, project)) {
+			return null;
+		}
+		// Check if an active candidate with this (signature, scope, project) already exists
+		const existing = project
+			? (this.db.db
+					.query(
+						"SELECT id FROM candidates WHERE signature = ? AND scope = ? AND project = ? AND status != 'deleted'",
+					)
+					.get(input.signature, scope, project) as { id: string } | null)
+			: (this.db.db
+					.query(
+						"SELECT id FROM candidates WHERE signature = ? AND scope = ? AND project IS NULL AND status != 'deleted'",
+					)
+					.get(input.signature, scope) as { id: string } | null);
+
+		if (existing) {
+			return existing.id;
+		}
+
+		const id = `cand_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+		const now = Date.now();
+		const sanitizedTitle = redactEvidence(input.title).slice(0, 200);
+		const sanitizedContent = redactEvidence(input.content).slice(0, 10000);
+		const sanitizedSig = redactEvidence(input.signature).slice(0, 300);
+		const sanitizedEvidence = redactEvidence(input.evidence).slice(0, 10000);
+
+		try {
+			this.db.db
+				.query(
+					`INSERT INTO candidates (id, kind, scope, project, title, content, signature, evidence, status, passes, version, created_at, updated_at)
+					 VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', 0, 1, ?, ?)`,
+				)
+				.run(
+					id,
+					input.kind,
+					scope,
+					project ?? null,
+					sanitizedTitle,
+					sanitizedContent,
+					sanitizedSig,
+					sanitizedEvidence,
+					now,
+					now,
+				);
+		} catch (err) {
+			// Catch SQLite unique constraint violation in case of race
+			const existingAfterRace = project
+				? (this.db.db
+						.query(
+							"SELECT id FROM candidates WHERE signature = ? AND scope = ? AND project = ? AND status != 'deleted'",
+						)
+						.get(input.signature, scope, project) as { id: string } | null)
+				: (this.db.db
+						.query(
+							"SELECT id FROM candidates WHERE signature = ? AND scope = ? AND project IS NULL AND status != 'deleted'",
+						)
+						.get(input.signature, scope) as { id: string } | null);
+			if (existingAfterRace) return existingAfterRace.id;
+			throw err;
+		}
+
+		this.recordEvent(id, "candidate_created", JSON.stringify({ title: sanitizedTitle, signature: sanitizedSig, scope, project }));
+		return id;
+	}
+	getCandidate(
+		id: string,
+		auth?: { currentProject?: string; allowGlobal?: boolean },
+	): (CandidateRow & { projectedMemoryId?: string }) | null {
+		const row = this.db.db.query("SELECT * FROM candidates WHERE id = ?").get(id) as CandidateRow | null;
+		if (!row) return null;
+		if (auth?.currentProject !== undefined) {
+			// Check authorization:
+			// - Project scope: candidate.project MUST match currentProject
+			// - Local scope: candidate.project MUST match currentProject
+			// - Global scope: only permitted if allowGlobal is true or explicitly permitted
+			if (row.scope === "project" || row.scope === "local") {
+				if (row.project !== auth.currentProject) {
+					return null;
+				}
+			} else if (row.scope === "global" && auth.allowGlobal === false) {
+				return null;
+			}
+		}
+		return {
+			...row,
+			projectedMemoryId: row.projected_memory_id ?? undefined,
+		};
+	}
+
+	listCandidates(
+		status?: "pending" | "promoted" | "rejected" | "deleted" | "needs_review",
+		auth?: { currentProject?: string; includeGlobal?: boolean },
+	): Array<CandidateRow & { projectedMemoryId?: string }> {
+		let queryStr = "SELECT * FROM candidates";
+		const conditions: string[] = [];
+		const params: (string | number)[] = [];
+
+		if (status) {
+			conditions.push("status = ?");
+			params.push(status);
+		}
+
+		if (auth?.currentProject !== undefined) {
+			if (auth.includeGlobal !== false) {
+				conditions.push("((scope IN ('project', 'local') AND project = ?) OR scope = 'global')");
+				params.push(auth.currentProject);
+			} else {
+				conditions.push("scope IN ('project', 'local') AND project = ?");
+				params.push(auth.currentProject);
+			}
+		}
+
+		if (conditions.length > 0) {
+			queryStr += " WHERE " + conditions.join(" AND ");
+		}
+
+		const rows = (params.length > 0
+			? this.db.db.query(queryStr).all(...params)
+			: this.db.db.query(queryStr).all()) as CandidateRow[];
+		return rows.map(row => ({
+			...row,
+			projectedMemoryId: row.projected_memory_id ?? undefined,
+		}));
+	}
+
+	recordPass(id: string, input: RecordPassInput): RecordPassResult {
+		const candidate = this.getCandidate(id);
+		if (!candidate) {
+			return { success: false, error: "candidate_not_found" };
+		}
+		if (candidate.status === "deleted") {
+			return { success: false, error: "candidate_deleted" };
+		}
+		if (candidate.version !== input.expectedVersion) {
+			return {
+				success: false,
+				error: `version_conflict: expected ${input.expectedVersion}, found ${candidate.version}`,
+			};
+		}
+
+		const now = Date.now();
+		const newPasses = candidate.passes + 1;
+		const newVersion = candidate.version + 1;
+
+		const updateRes = this.db.db
+			.query(
+				`UPDATE candidates SET passes = ?, version = ?, updated_at = ? WHERE id = ? AND version = ? AND status != 'deleted'`,
+			)
+			.run(newPasses, newVersion, now, id, candidate.version);
+
+		if (updateRes.changes === 0) {
+			return {
+				success: false,
+				error: "concurrent_modification",
+			};
+		}
+
+		// Record verdict
+		const verdictId = `vrd_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+		const sanitizedEvidence = redactEvidence(input.evidence ?? "").slice(0, 10000);
+		const sanitizedVerifier = redactEvidence(input.verifier).slice(0, 200);
+		this.db.db
+			.query(
+				`INSERT INTO verdicts (id, candidate_id, verifier, verdict, evidence, timestamp)
+				 VALUES (?, ?, ?, 'pass', ?, ?)`,
+			)
+			.run(verdictId, id, sanitizedVerifier, sanitizedEvidence, now);
+
+		this.recordEvent(id, "pass_recorded", JSON.stringify({ passes: newPasses, verifier: sanitizedVerifier }));
+
+		const updated = this.getCandidate(id)!;
+		return { success: true, candidate: updated };
+	}
+	isEligibleForPromotion(candidate: CandidateRow, minPasses = 2): boolean {
+		// Only rules and facts promote directly into memory projection; procedures remain pending for skill threshold
+		return candidate.kind !== "procedure" && candidate.status === "pending" && candidate.passes >= minPasses;
+	}
+	async promoteCandidate(
+		id: string,
+		options: { memory?: MemoryRuntimeContext; minPasses?: number; currentProject?: string; allowGlobal?: boolean },
+	): Promise<{ success: boolean; memoryId?: string; error?: string }> {
+		return await this.serialize(id, async () => {
+			const candidate = this.getCandidate(id, {
+				currentProject: options.currentProject,
+				allowGlobal: options.allowGlobal ?? true,
+			});
+			if (!candidate) {
+				// Check if candidate exists under another project to return distinct unauthorized error
+				const rawCandidate = this.getCandidate(id);
+				if (rawCandidate) {
+					return { success: false, error: "unauthorized_cross_project_candidate" };
+				}
+				return { success: false, error: "candidate_not_found" };
+			}
+			if (!this.isEligibleForPromotion(candidate, options.minPasses ?? 2)) {
+				return { success: false, error: "not_eligible_for_promotion" };
+			}
+
+			// Promotion requires an active memory backend context
+			if (!options.memory) {
+				return { success: false, error: "memory_backend_required_for_promotion" };
+			}
+
+			// Atomic claim: set status to promoting
+			const claimTime = Date.now();
+			const claimRes = this.db.db
+				.query("UPDATE candidates SET status = 'promoting', updated_at = ? WHERE id = ? AND status = 'pending'")
+				.run(claimTime, id);
+
+			if (claimRes.changes === 0) {
+				return { success: false, error: "concurrent_promotion" };
+			}
+
+			// Always route with candidate's stored scope and project
+			const saveRes = await options.memory.save({
+				content: candidate.content,
+				context: candidate.evidence,
+				source: "omp-autolearn",
+				importance: 0.8,
+				scope: candidate.scope,
+				project: candidate.project,
+			});
+
+			if (!saveRes.stored || saveRes.stored <= 0 || !saveRes.ids || saveRes.ids.length === 0) {
+				// Rollback claim on failure
+				this.db.db
+					.query("UPDATE candidates SET status = 'pending', updated_at = ? WHERE id = ? AND status = 'promoting'")
+					.run(Date.now(), id);
+				this.recordEvent(id, "promotion_failed", JSON.stringify({ error: saveRes.message ?? "memory_save_failed" }));
+				return { success: false, error: saveRes.message ?? "memory_save_failed" };
+			}
+			const projectedMemoryId = saveRes.ids[0];
+
+			const now = Date.now();
+			const promoteRes = this.db.db
+				.query(
+					`UPDATE candidates SET status = 'promoted', projected_memory_id = ?, updated_at = ?, version = version + 1 WHERE id = ? AND status = 'promoting'`,
+				)
+				.run(projectedMemoryId, now, id);
+
+			if (promoteRes.changes === 0) {
+				// Promotion state raced/modified while memory save was in flight; attempt clean forget to avoid orphan
+				if (options.memory.edit) {
+					try {
+						await options.memory.edit("forget", projectedMemoryId, {
+							scope: candidate.scope,
+							project: candidate.project,
+						});
+					} catch {}
+				}
+				return { success: false, error: "concurrent_modification" };
+			}
+
+			this.recordEvent(id, "promoted", JSON.stringify({ projectedMemoryId }));
+			return { success: true, memoryId: projectedMemoryId };
+		});
+	}
+	async deleteCandidate(
+		id: string,
+		options?: { memory?: MemoryRuntimeContext; reason?: string; currentProject?: string; allowGlobal?: boolean },
+	): Promise<{ success: boolean; error?: string }> {
+		return await this.serialize(id, async () => {
+			const candidate = this.getCandidate(id, {
+				currentProject: options?.currentProject,
+				allowGlobal: options?.allowGlobal ?? true,
+			});
+			if (!candidate) {
+				const rawCandidate = this.getCandidate(id);
+				if (rawCandidate) {
+					return { success: false, error: "unauthorized_cross_project_candidate" };
+				}
+				return { success: false, error: "candidate_not_found" };
+			}
+			if (candidate.status === "deleted") return { success: false, error: "candidate_already_deleted" };
+
+			// Claim deletion state atomically
+			const claimTime = Date.now();
+			const claimRes = this.db.db
+				.query("UPDATE candidates SET status = 'deleting', updated_at = ? WHERE id = ? AND status != 'deleted' AND status != 'deleting'")
+				.run(claimTime, id);
+			if (claimRes.changes === 0 && candidate.status !== "deleting") {
+				return { success: false, error: "concurrent_deletion" };
+			}
+
+			// 1. Delete from memory projection if promoted
+			if (candidate.projected_memory_id) {
+				if (!options?.memory || !options.memory.edit) {
+					// Rollback claim on missing backend
+					this.db.db
+						.query("UPDATE candidates SET status = ?, updated_at = ? WHERE id = ? AND status = 'deleting'")
+						.run(candidate.status === "deleting" ? "needs_review" : candidate.status, Date.now(), id);
+					return { success: false, error: "memory_backend_unavailable_cannot_confirm_delete" };
+				}
+				const editRes = await options.memory.edit("forget", candidate.projected_memory_id, {
+					scope: candidate.scope,
+					project: candidate.project,
+				});
+				if (editRes.status !== "deleted") {
+					this.recordEvent(id, "delete_failed", JSON.stringify({ error: "memory_edit_unconfirmed", status: editRes.status }));
+					this.db.db
+						.query("UPDATE candidates SET status = 'needs_review', updated_at = ? WHERE id = ? AND status = 'deleting'")
+						.run(Date.now(), id);
+					return { success: false, error: `memory_edit_unconfirmed: ${editRes.status}` };
+				}
+			}
+
+			// 2. Mark candidate deleted and record scoped tombstone atomically in a transaction
+			const now = Date.now();
+			const reason = options?.reason ?? "user_deleted";
+			let deleteSuccess = false;
+			const deleteTx = this.db.db.transaction(() => {
+				const updateRes = this.db.db
+					.query("UPDATE candidates SET status = 'deleted', updated_at = ? WHERE id = ? AND status = 'deleting'")
+					.run(now, id);
+				if (updateRes.changes > 0) {
+					deleteSuccess = true;
+					this.db.db
+						.query(
+							"INSERT OR REPLACE INTO tombstones (signature, scope, project, reason, timestamp) VALUES (?, ?, ?, ?, ?)",
+						)
+						.run(candidate.signature, candidate.scope, candidate.project ?? "", reason, now);
+				}
+			});
+			deleteTx();
+
+			if (!deleteSuccess) {
+				return { success: false, error: "candidate_already_deleted_or_raced" };
+			}
+
+			this.recordEvent(id, "deleted", JSON.stringify({ signature: candidate.signature, reason }));
+			return { success: true };
+		});
+	}
+
+	private recordEvent(candidateId: string, eventType: string, payload: string): void {
+		const eventId = `evt_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+		this.db.db
+			.query(
+				"INSERT INTO learn_events (id, candidate_id, event_type, payload, timestamp) VALUES (?, ?, ?, ?, ?)",
+			)
+			.run(eventId, candidateId, eventType, payload, Date.now());
+	}
+}
diff --git a/packages/coding-agent/src/autolearn/config.ts b/packages/coding-agent/src/autolearn/config.ts
