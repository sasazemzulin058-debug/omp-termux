diff --git a/packages/coding-agent/src/autolearn/index.ts b/packages/coding-agent/src/autolearn/index.ts
new file mode 100644
index 0000000..f44c675
--- /dev/null
+++ b/packages/coding-agent/src/autolearn/index.ts
@@ -0,0 +1,238 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { getAgentDir } from "@oh-my-pi/pi-utils";
+import type { ExtensionContext, ToolExecutionEndEvent, ToolExecutionStartEvent } from "../extensibility/extensions/types";
+import { CandidateLedger } from "./candidate-ledger";
+import { loadLearnConfig, type LearnConfig } from "./config";
+import { LearnDatabase } from "./learn-db";
+import { redactEvidence } from "./redact";
+import { ManagedSkillWriter } from "./skill-writer";
+import { VerifierEngine } from "./verifier";
+import { canonicalProjectIdentity } from "../mnemopi/config";
+
+export class CustomAutoLearnService {
+	readonly db: LearnDatabase;
+	readonly ledger: CandidateLedger;
+	readonly verifier: VerifierEngine;
+	readonly skillWriter: ManagedSkillWriter;
+	readonly config: LearnConfig;
+
+	constructor(agentDir: string = getAgentDir(), configOverride?: LearnConfig) {
+		this.config = configOverride ?? loadLearnConfig();
+		const dbPath = this.config.dbPath ?? path.join(agentDir, "learn.db");
+		this.db = new LearnDatabase(dbPath);
+		this.ledger = new CandidateLedger(this.db);
+		this.verifier = new VerifierEngine();
+		this.skillWriter = new ManagedSkillWriter({
+			managedSkillsDir: path.join(agentDir, "managed-skills"),
+		});
+	}
+
+	async dispose(): Promise<void> {
+		await this.db.closeAsync();
+	}
+}
+
+/**
+ * Standard OMP extension entry point for Custom AutoLearn.
+ */
+export default function customAutolearnExtension(pi: {
+	on: (event: string, handler: (event: unknown, ctx: ExtensionContext) => void | Promise<void>) => void;
+	registerCommand: (
+		name: string,
+		options: {
+			description?: string;
+			handler: (args: string, ctx: ExtensionContext) => void | Promise<void>;
+		},
+	) => void;
+}) {
+	let service: CustomAutoLearnService | null = null;
+
+	const ensureService = (ctx: ExtensionContext): CustomAutoLearnService | null => {
+		const cfg = loadLearnConfig(ctx.settings);
+		if (!cfg.enabled) {
+			if (service) {
+				void service.dispose();
+				service = null;
+			}
+			return null;
+		}
+		if (!service) {
+			service = new CustomAutoLearnService(undefined, cfg);
+		}
+		return service;
+	};
+
+	pi.on("session_start", (_event, ctx) => {
+		ensureService(ctx);
+	});
+
+	pi.on("tool_execution_start", (event: unknown, ctx: ExtensionContext) => {
+		const activeService = ensureService(ctx);
+		if (!activeService) return;
+		if (event && typeof event === "object" && "type" in event && event.type === "tool_execution_start") {
+			activeService.verifier.recordStart(event as unknown as ToolExecutionStartEvent);
+		}
+	});
+
+	pi.on("tool_execution_end", (event: unknown, ctx: ExtensionContext) => {
+		const activeService = ensureService(ctx);
+		if (!activeService) return;
+		if (!event || typeof event !== "object" || !("type" in event) || event.type !== "tool_execution_end") {
+			return;
+		}
+
+		const endEvent = event as unknown as ToolExecutionEndEvent;
+		const correlation = activeService.verifier.correlateEnd(endEvent, activeService.config.redactPatterns);
+		if (correlation.verdict !== "pass" || !correlation.matchedSignature) {
+			return;
+		}
+		const evidence = redactEvidence(correlation.evidence ?? "Automated verifier pass", activeService.config.redactPatterns);
+		const verifierName = correlation.verifierName ?? "test_runner";
+		const title = redactEvidence(`Verified fix via ${verifierName}`, activeService.config.redactPatterns);
+		const content = redactEvidence(`Resolution recorded via verifier ${verifierName}`, activeService.config.redactPatterns);
+
+		// Verifier resolutions represent verified candidate metadata;
+		// Automatic promotion to durable memory and automatic skill minting are disabled to prevent prompt injection and untrusted promotion.
+		// Explicit user review and `/learn approve` command is required for promotion.
+		const kind: "rule" | "fact" | "procedure" = "rule";
+		let project: string | undefined;
+		if (ctx.cwd) {
+			project = canonicalProjectIdentity(ctx.cwd);
+		}
+		const candidateId = activeService.ledger.createCandidate({
+			kind,
+			scope: activeService.config.defaultScope,
+			project,
+			title,
+			content,
+			signature: correlation.matchedSignature,
+			evidence,
+		});
+		if (candidateId) {
+			const candidate = activeService.ledger.getCandidate(candidateId);
+			if (candidate && candidate.status === "pending") {
+				activeService.ledger.recordPass(candidateId, {
+					expectedVersion: candidate.version,
+					verifier: `${endEvent.toolName}:${correlation.verifierName ?? "unknown"}`,
+					evidence,
+				});
+			}
+		}
+	});
+
+	pi.on("session_shutdown", async () => {
+		if (service) {
+			const cur = service;
+			service = null;
+			await cur.dispose();
+		}
+	});
+
+	// Register /learn command
+	// Register /learn command with project scope authorization
+	pi.registerCommand("learn", {
+		description: "Inspect and manage custom autolearn candidates and configuration",
+		handler: async (args: string, ctx: ExtensionContext) => {
+			const activeService = ensureService(ctx);
+			if (!activeService) {
+				ctx.ui.notify?.("Autolearn is not active in custom mode.", "error");
+				return;
+			}
+			const currentProject = ctx.cwd ? canonicalProjectIdentity(ctx.cwd) : undefined;
+			const auth = { currentProject, includeGlobal: true, allowGlobal: true };
+			const parts = args.trim().split(/\s+/).filter(Boolean);
+			const sub = parts[0] || "status";
+			const targetId = parts[1];
+
+			switch (sub) {
+				case "status": {
+					const candidates = activeService.ledger.listCandidates(undefined, auth);
+					const pending = candidates.filter(c => c.status === "pending").length;
+					const promoted = candidates.filter(c => c.status === "promoted").length;
+					const deleted = candidates.filter(c => c.status === "deleted").length;
+					ctx.ui.notify?.(
+						`Autolearn (${activeService.config.mode}): ${pending} pending, ${promoted} promoted, ${deleted} deleted. Config: scope=${activeService.config.defaultScope}, minPassesRule=${activeService.config.minPassesRule}`,
+						"info",
+					);
+					break;
+				}
+				case "view": {
+					if (!targetId) {
+						const list = activeService.ledger
+							.listCandidates(undefined, auth)
+							.map(c => `[${c.id}] (${c.status}) passes=${c.passes} - ${c.title}`)
+							.join("\n");
+						ctx.ui.notify?.(list || "No candidates found.", "info");
+					} else {
+						const c = activeService.ledger.getCandidate(targetId, auth);
+						if (!c) {
+							ctx.ui.notify?.(`Candidate ${targetId} not found.`, "error");
+						} else {
+							ctx.ui.notify?.(
+								`ID: ${c.id}\nStatus: ${c.status}\nPasses: ${c.passes} (v${c.version})\nContent:\n${c.content}\nEvidence:\n${c.evidence}`,
+								"info",
+							);
+						}
+					}
+					break;
+				}
+                case "approve": {
+                    if (!targetId) {
+                        ctx.ui.notify?.("Usage: /learn approve <candidate-id> <reviewed-content>", "error");
+                        return;
+                    }
+                    const reviewedContent = parts.slice(2).join(" ").trim();
+                    if (!reviewedContent) {
+                        ctx.ui.notify?.("Usage: /learn approve <candidate-id> <reviewed-content>", "error");
+                        return;
+                    }
+                    const res = await activeService.ledger.promoteCandidate(targetId, {
+                        memory: ctx.memory,
+                        content: reviewedContent,
+                        minPasses: 0,
+                        currentProject,
+                        allowGlobal: true,
+                    });
+                    if (res.success) {
+                        ctx.ui.notify?.(`Candidate ${targetId} approved and promoted.`, "info");
+                    } else {
+                        ctx.ui.notify?.(`Approval failed: ${res.error}`, "error");
+                    }
+                    break;
+                }
+				case "delete": {
+					if (!targetId) {
+						ctx.ui.notify?.("Usage: /learn delete <candidate-id>", "error");
+						return;
+					}
+					const res = await activeService.ledger.deleteCandidate(targetId, {
+						memory: ctx.memory,
+						reason: "user_delete_command",
+						currentProject,
+						allowGlobal: true,
+					});
+					if (res.success) {
+						ctx.ui.notify?.(`Candidate ${targetId} deleted and tombstoned.`, "info");
+					} else {
+						ctx.ui.notify?.(`Delete failed: ${res.error}`, "error");
+					}
+					break;
+				}
+				case "config": {
+					ctx.ui.notify?.(
+						`Config:\nMode: ${activeService.config.mode}\nDefault Scope: ${activeService.config.defaultScope}\nMin Passes (Rule): ${activeService.config.minPassesRule}\nMin Passes (Skill): ${activeService.config.minPassesSkill}\nMint Skills: ${activeService.config.mintSkills}`,
+					);
+					break;
+				}
+				default: {
+					ctx.ui.notify?.(
+						"Usage: /learn <status | view [id] | approve <id> | delete <id> | config>",
+						"info",
+					);
+					break;
+				}
+			}
+		},
+	});
+}
