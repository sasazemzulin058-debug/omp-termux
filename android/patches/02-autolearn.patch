+	it("verifies verifier requires explicit exitCode 0 and rejects omitted exitCode or failed exitCode", () => {
+		const engine = new VerifierEngine();
+		engine.recordStart({
+			type: "tool_execution_start",
+			toolCallId: "call-clean-1",
+			toolName: "bash",
+			args: { command: "bun test test/unit.test.ts" },
+		});
+		const fail = engine.correlateEnd({
+			type: "tool_execution_end",
+			toolCallId: "call-clean-1",
+			toolName: "bash",
+			result: { isError: true, error: "1 test failed" },
+			isError: true,
+		});
+		expect(fail.verdict).toBe("fail");
+
+		// Execution with undefined exitCode (transport only) is rejected as inconclusive
+		engine.recordStart({
+			type: "tool_execution_start",
+			toolCallId: "call-clean-2",
+			toolName: "bash",
+			args: { command: "bun test test/unit.test.ts" },
+		});
+		const omittedExit = engine.correlateEnd({
+			type: "tool_execution_end",
+			toolCallId: "call-clean-2",
+			toolName: "bash",
+			result: { isError: false, content: [{ type: "text", text: "1 test passed" }] },
+			isError: false,
+		});
+		expect(omittedExit.verdict).toBe("inconclusive");
+
+		// Execution with exitCode 0 passes
+		engine.recordStart({
+			type: "tool_execution_start",
+			toolCallId: "call-clean-3",
+			toolName: "bash",
+			args: { command: "bun test test/unit.test.ts" },
+		});
+		const pass = engine.correlateEnd({
+			type: "tool_execution_end",
+			toolCallId: "call-clean-3",
+			toolName: "bash",
+			result: { isError: false, exitCode: 0, content: [{ type: "text", text: "1 test passed" }] },
+			isError: false,
+		});
+		expect(pass.verdict).toBe("pass");
+		expect(pass.matchedSignature).toBe(fail.matchedSignature);
+	});
