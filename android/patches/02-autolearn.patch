index 0000000..a0108c1
--- /dev/null
+++ b/packages/coding-agent/src/autolearn/skill-writer.ts
@@ -0,0 +1,63 @@
+import { getManagedSkillsDir, sanitizeSkillName, writeManagedSkill } from "./managed-skills";
+
+export interface ManagedSkillWriterOptions {
+	managedSkillsDir?: string;
+}
+
+export interface WriteSkillParams {
+	name: string;
+	description: string;
+	instructions: string;
+}
+
+export class ManagedSkillWriter {
+	readonly managedSkillsDir: string;
+
+	constructor(options: ManagedSkillWriterOptions = {}) {
+		this.managedSkillsDir = options.managedSkillsDir ?? getManagedSkillsDir();
+	}
+
+	validateSkillName(name: string): string {
+		return sanitizeSkillName(name);
+	}
+
+	isEligibleForSkill(
+		candidate: { kind: string; passes: number; content?: string },
+		minPasses = 3,
+	): boolean {
+		if (candidate.kind !== "procedure" || candidate.passes < minPasses) {
+			return false;
+		}
+		const content = candidate.content?.trim() ?? "";
+		// Refuse placeholder, synthetic, or unreviewed signature text
+		if (
+			!content ||
+			content.length < 20 ||
+			content.startsWith("Verified resolution for") ||
+			content.startsWith("Fix for") ||
+			content.includes("cand_")
+		) {
+			return false;
+		}
+		return true;
+	}
+
+	async writeSkill(params: WriteSkillParams): Promise<{ path: string }> {
+		const instructions = params.instructions.trim();
+		if (
+			!instructions ||
+			instructions.length < 20 ||
+			instructions.startsWith("Verified resolution for") ||
+			instructions.startsWith("Fix for")
+		) {
+			throw new Error("Cannot write managed skill with unreviewed or placeholder procedure content.");
+		}
+		return await writeManagedSkill({
+			action: "create",
+			name: params.name,
+			description: params.description,
+			body: instructions,
+			managedSkillsDir: this.managedSkillsDir,
+		});
+	}
+}
diff --git a/packages/coding-agent/src/autolearn/verifier.ts b/packages/coding-agent/src/autolearn/verifier.ts
new file mode 100644
index 0000000..f1aba61
--- /dev/null
+++ b/packages/coding-agent/src/autolearn/verifier.ts
@@ -0,0 +1,175 @@
+import { extractFailureSignature, redactEvidence } from "./redact";
+import type { ToolExecutionEndEvent, ToolExecutionStartEvent } from "../extensibility/extensions/types";
+
+export interface RegisteredVerifier {
+	name: string;
+	toolName: string;
+	matcher: (args: Record<string, unknown>) => boolean;
+	semanticSuccessPredicate: (result: unknown) => boolean;
+}
+
+export const BUILTIN_VERIFIERS: RegisteredVerifier[] = [
+	{
+		name: "test_runner",
+		toolName: "bash",
+		matcher: args => {
+			const cmd = typeof args.command === "string" ? args.command : "";
+			return /^(bun test|npm test|vitest|jest|pytest|cargo test)\b/i.test(cmd.trim());
+		},
+		semanticSuccessPredicate: result => {
+			if (!result || typeof result !== "object") return false;
+			const r = result as Record<string, unknown>;
+			if (r.isError === true || r.error !== undefined) {
+				return false;
+			}
+			const details = (r.details && typeof r.details === "object" ? r.details : undefined) as
+				| Record<string, unknown>
+				| undefined;
+			if (r.timedOut === true || details?.timedOut === true) {
+				return false;
+			}
+			const exitCode =
+				typeof r.exitCode === "number"
+					? r.exitCode
+					: typeof details?.exitCode === "number"
+						? details.exitCode
+						: undefined;
+			return r.isError === false && (exitCode === undefined || exitCode === 0);
+		},
+	},
+	{
+		name: "linter_checker",
+		toolName: "bash",
+		matcher: args => {
+			const cmd = typeof args.command === "string" ? args.command : "";
+			return /^(bunx tsc|npm run typecheck|tsc --noEmit|cargo clippy|eslint)\b/i.test(cmd.trim());
+		},
+		semanticSuccessPredicate: result => {
+			if (!result || typeof result !== "object") return false;
+			const r = result as Record<string, unknown>;
+			if (r.isError === true || r.error !== undefined) {
+				return false;
+			}
+			const details = (r.details && typeof r.details === "object" ? r.details : undefined) as
+				| Record<string, unknown>
+				| undefined;
+			if (r.timedOut === true || details?.timedOut === true) {
+				return false;
+			}
+			const exitCode =
+				typeof r.exitCode === "number"
+					? r.exitCode
+					: typeof details?.exitCode === "number"
+						? details.exitCode
+						: undefined;
+			return r.isError === false && (exitCode === undefined || exitCode === 0);
+		},
+	},
+];
+
+export interface CorrelationResult {
+	verdict: "pass" | "fail" | "inconclusive";
+	matchedSignature?: string;
+	verifierName?: string;
+	evidence?: string;
+}
+
+export class VerifierEngine {
+	private readonly inFlightCalls = new Map<string, ToolExecutionStartEvent>();
+	private readonly failureSignatures = new Map<string, string>();
+	private readonly registeredVerifiers: RegisteredVerifier[] = [...BUILTIN_VERIFIERS];
+
+	registerVerifier(verifier: RegisteredVerifier): void {
+		this.registeredVerifiers.push(verifier);
+	}
+
+	recordStart(event: ToolExecutionStartEvent): void {
+		if (event.toolCallId) {
+			this.inFlightCalls.set(event.toolCallId, event);
+		}
+	}
+
+	private extractErrorString(result: unknown, customPatterns: string[] = []): string {
+		if (!result) return "Unknown error";
+		let raw = "";
+		if (typeof result === "string") {
+			raw = result;
+		} else if (typeof result === "object" && result !== null) {
+			if ("content" in result && Array.isArray(result.content)) {
+				const parts: string[] = [];
+				for (const item of result.content) {
+					if (
+						item &&
+						typeof item === "object" &&
+						"type" in item &&
+						item.type === "text" &&
+						"text" in item &&
+						typeof item.text === "string"
+					) {
+						parts.push(item.text);
+					}
+				}
+				if (parts.length > 0) raw = parts.join("\n");
+			}
+			if (!raw && "error" in result && typeof result.error === "string") raw = result.error;
+			if (!raw && "message" in result && typeof result.message === "string") raw = result.message;
+			if (!raw) {
+				try {
+					raw = JSON.stringify(result);
+				} catch {
+					raw = String(result);
+				}
+			}
+		} else {
+			raw = String(result);
+		}
+		return redactEvidence(raw, customPatterns);
+	}
+
+	private getVerifierKey(toolName: string, args?: Record<string, unknown>, customPatterns: string[] = []): string {
+		if (!args) return toolName;
+		const rawParam = typeof args.command === "string" ? args.command : typeof args.path === "string" ? args.path : "";
+		const sanitizedParam = redactEvidence(rawParam, customPatterns).slice(0, 120);
+		return `${toolName}:${sanitizedParam}`;
+	}
+
+	correlateEnd(event: ToolExecutionEndEvent, customPatterns: string[] = []): CorrelationResult {
+		const start = this.inFlightCalls.get(event.toolCallId);
+		this.inFlightCalls.delete(event.toolCallId);
+
+		const args = start?.args ?? {};
+		const key = this.getVerifierKey(event.toolName, args, customPatterns);
+		const priorSig = this.failureSignatures.get(key);
+
+		// Find registered verifier
+		const verifier = this.registeredVerifiers.find(v => v.toolName === event.toolName && v.matcher(args));
+
+		if (event.isError) {
+			const errStr = this.extractErrorString(event.result, customPatterns);
+			const sig = extractFailureSignature(event.toolName, args, errStr, customPatterns);
+			this.failureSignatures.set(key, sig);
+			return {
+				verdict: "fail",
+				matchedSignature: sig,
+				verifierName: verifier?.name,
+				evidence: errStr,
+			};
+		}
+
+		// Require pre-registered verifier AND semantic predicate pass AND prior matching failure
+		if (priorSig && verifier) {
+			const semanticPass = verifier.semanticSuccessPredicate(event.result);
+			if (semanticPass) {
+				this.failureSignatures.delete(key);
+				return {
+					verdict: "pass",
+					matchedSignature: priorSig,
+					verifierName: verifier.name,
+					evidence: `Verified resolution via ${verifier.name} for ${priorSig}`,
+				};
+			}
+		}
+
+		return { verdict: "inconclusive" };
+	}
+}
