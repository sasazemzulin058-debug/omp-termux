+++ b/packages/coding-agent/src/autolearn/learn-db.ts
@@ -0,0 +1,191 @@
+import { Database } from "bun:sqlite";
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+export interface EpisodeRow {
+	id: string;
+	session_id: string;
+	cwd: string;
+	timestamp: number;
+	metadata?: string;
+}
+
+export interface CandidateRow {
+	id: string;
+	kind: "rule" | "fact" | "procedure";
+	scope: "local" | "project" | "global";
+	project?: string;
+	title: string;
+	content: string;
+	signature: string;
+	evidence: string;
+	status: "pending" | "promoting" | "promoted" | "rejected" | "deleted" | "needs_review";
+	passes: number;
+	version: number;
+	projected_memory_id?: string;
+	created_at: number;
+	updated_at: number;
+}
+
+export interface VerdictRow {
+	id: string;
+	candidate_id: string;
+	verifier: string;
+	verdict: "pass" | "fail" | "inconclusive";
+	evidence?: string;
+	timestamp: number;
+}
+
+export interface LearnEventRow {
+	id: string;
+	candidate_id: string;
+	event_type: string;
+	payload: string;
+	timestamp: number;
+}
+
+export interface TombstoneRow {
+	signature: string;
+	scope: string;
+	project?: string;
+	reason: string;
+	timestamp: number;
+}
+
+export class LearnDatabase {
+	readonly db: Database;
+	readonly dbPath: string;
+	private readonly activeJobs = new Set<Promise<unknown>>();
+
+	constructor(dbPath: string) {
+		this.dbPath = dbPath;
+		const dir = path.dirname(dbPath);
+		if (!fs.existsSync(dir)) {
+			fs.mkdirSync(dir, { recursive: true });
+		}
+		this.db = new Database(dbPath, { create: true });
+
+		// Secure permissions on Unix (0600)
+		if (process.platform !== "win32" && fs.existsSync(dbPath)) {
+			try {
+				fs.chmodSync(dbPath, 0o600);
+			} catch {
+				// ignore if chmod fails on special fs
+			}
+		}
+
+		this.initPragmas();
+		this.initSchema();
+	}
+
+	private initPragmas(): void {
+		this.db.run("PRAGMA journal_mode = WAL;");
+		this.db.run("PRAGMA busy_timeout = 5000;");
+		this.db.run("PRAGMA foreign_keys = ON;");
+	}
+
+	private initSchema(): void {
+		this.db.run(`
+			CREATE TABLE IF NOT EXISTS episodes (
+				id TEXT PRIMARY KEY,
+				session_id TEXT NOT NULL,
+				cwd TEXT NOT NULL,
+				timestamp INTEGER NOT NULL,
+				metadata TEXT
+			);
+		`);
+
+		this.db.run(`
+			CREATE TABLE IF NOT EXISTS candidates (
+				id TEXT PRIMARY KEY,
+				kind TEXT NOT NULL,
+				scope TEXT NOT NULL,
+				project TEXT,
+				title TEXT NOT NULL,
+				content TEXT NOT NULL,
+				signature TEXT NOT NULL,
+				evidence TEXT NOT NULL,
+				status TEXT NOT NULL,
+				passes INTEGER NOT NULL DEFAULT 0,
+				version INTEGER NOT NULL DEFAULT 1,
+				projected_memory_id TEXT,
+				created_at INTEGER NOT NULL,
+				updated_at INTEGER NOT NULL
+			);
+		`);
+
+		this.db.run(`
+			CREATE UNIQUE INDEX IF NOT EXISTS uq_candidates_active_sig ON candidates (
+				signature,
+				scope,
+				COALESCE(project, '')
+			) WHERE status != 'deleted';
+		`);
+
+		this.db.run(`
+			CREATE INDEX IF NOT EXISTS idx_candidates_sig_scope_proj ON candidates (signature, scope, project, status);
+		`);
+
+		this.db.run(`
+			CREATE INDEX IF NOT EXISTS idx_candidates_status ON candidates (status);
+		`);
+
+		this.db.run(`
+			CREATE TABLE IF NOT EXISTS verdicts (
+				id TEXT PRIMARY KEY,
+				candidate_id TEXT NOT NULL,
+				verifier TEXT NOT NULL,
+				verdict TEXT NOT NULL,
+				evidence TEXT,
+				timestamp INTEGER NOT NULL,
+				FOREIGN KEY(candidate_id) REFERENCES candidates(id) ON DELETE CASCADE
+			);
+		`);
+
+		this.db.run(`
+			CREATE TABLE IF NOT EXISTS learn_events (
+				id TEXT PRIMARY KEY,
+				candidate_id TEXT NOT NULL,
+				event_type TEXT NOT NULL,
+				payload TEXT NOT NULL,
+				timestamp INTEGER NOT NULL
+			);
+		`);
+
+		this.db.run(`
+			CREATE TABLE IF NOT EXISTS tombstones (
+				signature TEXT NOT NULL,
+				scope TEXT NOT NULL,
+				project TEXT NOT NULL DEFAULT '',
+				reason TEXT NOT NULL,
+				timestamp INTEGER NOT NULL,
+				PRIMARY KEY (signature, scope, project)
+			);
+		`);
+	}
+
+	listTables(): string[] {
+		const rows = this.db.query("SELECT name FROM sqlite_master WHERE type='table'").all() as Array<{ name: string }>;
+		return rows.map(r => r.name);
+	}
+	trackJob<T>(promise: Promise<T>): Promise<T> {
+		this.activeJobs.add(promise);
+		void promise.finally(() => this.activeJobs.delete(promise));
+		return promise;
+	}
+
+	async drainJobs(): Promise<void> {
+		if (this.activeJobs.size > 0) {
+			await Promise.allSettled(Array.from(this.activeJobs));
+		}
+	}
+
+	close(): void {
+		this.db.close();
+	}
+
+	async closeAsync(): Promise<void> {
+		await this.drainJobs();
+		this.db.close();
+	}
+}
