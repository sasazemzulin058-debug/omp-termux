index 0000000..da2b76a
--- /dev/null
+++ b/packages/coding-agent/src/autolearn/config.ts
@@ -0,0 +1,82 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { YAML } from "bun";
+import { getAgentDir } from "@oh-my-pi/pi-utils";
+import type { Settings } from "../config/settings";
+
+export interface LearnConfig {
+	enabled: boolean;
+	mode: "off" | "builtin" | "custom";
+	minPassesRule: number;
+	minPassesSkill: number;
+	defaultScope: "local" | "project" | "global";
+	mintSkills: boolean;
+	redactPatterns: string[];
+	dbPath?: string;
+}
+
+export const DEFAULT_LEARN_CONFIG: LearnConfig = {
+	enabled: false,
+	mode: "off",
+	minPassesRule: 2,
+	minPassesSkill: 3,
+	defaultScope: "project",
+	mintSkills: true,
+	redactPatterns: [],
+};
+
+export function getDefaultLearnConfigPath(agentDir: string = getAgentDir()): string {
+	return path.join(agentDir, "learn.yml");
+}
+
+export function resolveAutolearnMode(settings?: Settings): "off" | "builtin" | "custom" {
+	if (!settings) return "off";
+	if (settings.isConfigured("autolearn.mode")) {
+		const rawMode = settings.get("autolearn.mode");
+		return rawMode === "builtin" || rawMode === "custom" || rawMode === "off" ? rawMode : "off";
+	}
+	return settings.get("autolearn.enabled") ? "builtin" : "off";
+}
+
+export function loadLearnConfig(settings?: Settings, configPath?: string): LearnConfig {
+	// First check settings if provided
+	if (settings) {
+		const mode = resolveAutolearnMode(settings);
+		return {
+			enabled: mode === "custom",
+			mode,
+			minPassesRule: settings.get("autolearn.minPassesRule") ?? DEFAULT_LEARN_CONFIG.minPassesRule,
+			minPassesSkill: settings.get("autolearn.minPassesSkill") ?? DEFAULT_LEARN_CONFIG.minPassesSkill,
+			defaultScope: (settings.get("autolearn.defaultScope") as "local" | "project" | "global") ?? DEFAULT_LEARN_CONFIG.defaultScope,
+			mintSkills: settings.get("autolearn.mintSkills") ?? DEFAULT_LEARN_CONFIG.mintSkills,
+			redactPatterns: settings.get("autolearn.redactPatterns") ?? DEFAULT_LEARN_CONFIG.redactPatterns,
+		};
+	}
+
+	// Legacy migration fallback for standalone learn.yml
+	const resolvedPath = configPath ?? getDefaultLearnConfigPath();
+	if (!fs.existsSync(resolvedPath)) {
+		return { ...DEFAULT_LEARN_CONFIG };
+	}
+
+	try {
+		const raw = fs.readFileSync(resolvedPath, "utf-8");
+		const parsed = YAML.parse(raw) as Partial<LearnConfig> | null;
+		if (!parsed || typeof parsed !== "object") {
+			return { ...DEFAULT_LEARN_CONFIG };
+		}
+		const enabled = Boolean(parsed.enabled);
+		return {
+			enabled,
+			mode: enabled ? "custom" : "off",
+			minPassesRule: parsed.minPassesRule ?? DEFAULT_LEARN_CONFIG.minPassesRule,
+			minPassesSkill: parsed.minPassesSkill ?? DEFAULT_LEARN_CONFIG.minPassesSkill,
+			defaultScope: parsed.defaultScope ?? DEFAULT_LEARN_CONFIG.defaultScope,
+			mintSkills: parsed.mintSkills ?? DEFAULT_LEARN_CONFIG.mintSkills,
+			redactPatterns: Array.isArray(parsed.redactPatterns) ? parsed.redactPatterns : [],
+			dbPath: typeof parsed.dbPath === "string" ? parsed.dbPath : undefined,
+		};
+	} catch {
+		return { ...DEFAULT_LEARN_CONFIG };
